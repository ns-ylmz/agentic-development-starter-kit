{
  "guard-git-and-pr": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          { "type": "command", "command": "../.ai/hooks/guard-git.sh" },
          { "type": "command", "command": "../.ai/hooks/guard-pr-body.sh" }
        ]
      },
      {
        "matcher": "mcp_.*pull_request_create",
        "hooks": [{ "type": "command", "command": "../.ai/hooks/guard-pr-body.sh" }]
      }
    ]
  },
  "guard-domain-boundary": {
    "PreToolUse": [
      {
        "matcher": "replace_file_content|write_to_file",
        "hooks": [{ "type": "command", "command": "../.ai/hooks/guard-domain-boundary.sh" }]
      }
    ]
  },
  "post-edit-verify": {
    "PostToolUse": [
      {
        "matcher": "replace_file_content|write_to_file",
        "hooks": [{ "type": "command", "command": "../.ai/hooks/post-edit-verify.sh" }]
      }
    ]
  },
  "suggest-branch-cleanup": {
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [{ "type": "command", "command": "../.ai/hooks/suggest-branch-cleanup.sh" }]
      }
    ]
  },
  "remind-return-to-main": {
    "PostToolUse": [
      {
        "matcher": "mcp_.*pull_request_create",
        "hooks": [{ "type": "command", "command": "../.ai/hooks/remind-return-to-main.sh" }]
      }
    ]
  }
}
